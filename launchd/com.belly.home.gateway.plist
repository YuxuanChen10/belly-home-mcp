<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.belly.home.gateway</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>--env-file-if-exists=/Users/cc/Library/Application Support/Belly Home Infra/gateway/.env</string>
    <string>/Users/cc/Library/Application Support/Belly Home Infra/gateway/src/server.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/cc/Library/Application Support/Belly Home Infra/gateway</string>
  <key>StandardOutPath</key>
  <string>/Users/cc/Library/Logs/Belly Home Infra/gateway.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/cc/Library/Logs/Belly Home Infra/gateway.err.log</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
