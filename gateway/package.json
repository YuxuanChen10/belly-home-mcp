{
  "name": "alarm-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "mcp": "node --env-file-if-exists=.env src/mcp-server.mjs",
    "mcp:create": "node --env-file-if-exists=.env src/mcp-create-server.mjs",
    "mcp:create:http": "node --env-file-if-exists=.env src/server.mjs",
    "test": "node --test",
    "e2e:mcp": "node scripts/mcp-e2e.mjs",
    "deploy:mcp": "node scripts/deploy-mcp-update.mjs",
    "repair:services": "bash scripts/repair-services.sh",
    "launchd:install": "node scripts/install-launchagents.mjs",
    "demo": "node --env-file-if-exists=.env scripts/demo.mjs",
    "pairing-code": "node --env-file-if-exists=.env scripts/pairing-code.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "jose": "6.2.12",
    "zod": "4.6.5"
  }
}
