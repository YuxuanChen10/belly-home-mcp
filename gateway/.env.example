BELLY_HOME_PORT=8787
HOST=0.0.0.0
ALARM_GATEWAY_TOKEN=dev-admin-token
# Separate credential accepted only by the create-only plugin endpoint.
ALARM_PLUGIN_TOKEN=replace-with-a-long-random-token
ALARM_PLUGIN_RATE_LIMIT=6
ALARM_DEVICE_ID=
ALARM_TIMEZONE=Australia/Melbourne
# Diary Markdown root. Defaults to ~/Library/Application Support/Belly Home Infra/Diary.
DIARY_ROOT_DIR=
BELLY_HOME_ROOT_DIR=
# Diary call audit log. Defaults to ~/Library/Logs/Belly Home Infra/diary-mcp.log.
DIARY_LOG_FILE=
# Sandboxed helper executable inside BellyHomeDesktopHelper.app. The bundled path is used by default.
BELLY_DESKTOP_HELPER_PATH=
# Metadata-only Desktop audit log. Defaults to ~/Library/Logs/Belly Home Infra/desktop-mcp.log.
DESKTOP_LOG_FILE=
ALARM_DATA_FILE=./data/gateway.json
# Optional APNs wake-up. Leave blank for manual foreground sync.
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.cc.alarmgateway.c4f7a9
APNS_ENVIRONMENT=development
